<UserControl
    x:Class="neat.DlList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:n="using:neat">

    <!-- The list of the Downloads section. Like LibList (liblist.xaml) it is a ListView that
         only builds the rows on screen, but its rows are Download objects that change while
         they are shown: every number, the status line and the bar are bound OneWay, so a
         running download updates its own row and the list itself is never rebuilt. -->
    <UserControl.Resources>
        <!-- Dim text. Its colour is set in code (DlList.Paint) so it follows the window colour. -->
        <SolidColorBrush x:Key="libdim"/>

        <!-- File icon by type, name, status line, and a thin progress bar while it runs. The
             height of the row is fixed so rows do not jump when a bar appears or goes. The
             "more" button shows on hover and opens the same menu as a right click. -->
        <DataTemplate x:Key="row" x:DataType="n:Download">
            <Grid
                Height="58"
                ColumnSpacing="10"
                Background="Transparent"
                PointerEntered="row_In"
                PointerExited="row_Out"
                RightTapped="row_Menu">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        Text="{x:Bind Line, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource libdim}"
                        TextTrimming="CharacterEllipsis"/>
                    <ProgressBar
                        Height="3"
                        MinHeight="3"
                        Maximum="100"
                        Value="{x:Bind Percent, Mode=OneWay}"
                        IsIndeterminate="{x:Bind Unknown, Mode=OneWay}"
                        Visibility="{x:Bind BarVis, Mode=OneWay}"/>
                </StackPanel>

                <!-- More (E712) is in both Segoe Fluent Icons and Segoe MDL2 Assets. -->
                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    Click="more_Click"
                    ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView
            x:Name="list"
            ItemTemplate="{StaticResource row}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="list_ItemClick"
            ContainerContentChanging="list_Row">
            <!-- The same settings as the tab list in win.xaml and the Library lists: washes on
                 hover and press, coloured in DlList.Paint, and the selection accent bar switched
                 off for real (hovering a row can otherwise crash Microsoft.UI.Xaml.dll; see the
                 neat-crash-lessons skill). -->
            <ListView.Resources>
                <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver"/>
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed"/>
            </ListView.Resources>
        </ListView>

        <!-- "No downloads found" and the like, in the middle of the list. -->
        <TextBlock
            x:Name="empty"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{StaticResource libdim}"
            Visibility="Collapsed"/>
    </Grid>
</UserControl>
